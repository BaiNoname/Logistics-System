<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LogisticsSystem.Employee.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:LogisticsSystem.Employee.Pages"
    Title="Logistics QR"
    FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Trang chủ"
            ContentTemplate="{DataTemplate pages:HomePage}"
            Icon="tab_home.svg"
            Route="home" />
        <ShellContent
            Title="Lịch sử"
            ContentTemplate="{DataTemplate pages:HistoryPage}"
            Icon="tab_history.svg"
            Route="history" />
        <ShellContent
            Title="Điều chỉnh"
            ContentTemplate="{DataTemplate pages:AdjustmentPage}"
            Icon="tab_adjustment.svg"
            Route="adjustment" />
        <ShellContent
            Title="Tài khoản"
            ContentTemplate="{DataTemplate pages:AccountPage}"
            Icon="tab_account.svg"
            Route="account" />
    </TabBar>

</Shell>
