<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Design tokens theo DESIGN.md (Apple). Chỉ một màu nhấn: Action Blue. -->

    <!-- Brand & accent -->
    <Color x:Key="ActionBlue">#0066CC</Color>
    <Color x:Key="FocusBlue">#0071E3</Color>
    <Color x:Key="SkyLinkBlue">#2997FF</Color>

    <!-- Surface -->
    <Color x:Key="Canvas">#FFFFFF</Color>
    <Color x:Key="Parchment">#F5F5F7</Color>
    <Color x:Key="PearlButton">#FAFAFC</Color>
    <Color x:Key="Tile1">#272729</Color>
    <Color x:Key="PureBlack">#000000</Color>

    <!-- Text -->
    <Color x:Key="Ink">#1D1D1F</Color>
    <Color x:Key="InkMuted80">#333333</Color>
    <Color x:Key="InkMuted48">#7A7A7A</Color>
    <Color x:Key="BodyMutedOnDark">#CCCCCC</Color>
    <Color x:Key="OnDark">#FFFFFF</Color>

    <!-- Hairline -->
    <Color x:Key="Hairline">#E0E0E0</Color>
    <Color x:Key="DividerSoft">#F0F0F0</Color>
    <Color x:Key="Error">#B42318</Color>
    <Color x:Key="CameraOverlay">#80000000</Color>

    <SolidColorBrush x:Key="ActionBlueBrush" Color="{StaticResource ActionBlue}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource Canvas}" />
    <SolidColorBrush x:Key="ParchmentBrush" Color="{StaticResource Parchment}" />
    <SolidColorBrush x:Key="Tile1Brush" Color="{StaticResource Tile1}" />
    <SolidColorBrush x:Key="PureBlackBrush" Color="{StaticResource PureBlack}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />
    <SolidColorBrush x:Key="InkMuted48Brush" Color="{StaticResource InkMuted48}" />
    <SolidColorBrush x:Key="BodyMutedOnDarkBrush" Color="{StaticResource BodyMutedOnDark}" />
    <SolidColorBrush x:Key="OnDarkBrush" Color="{StaticResource OnDark}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Hairline}" />

</ResourceDictionary>
