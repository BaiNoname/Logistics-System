<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="LogisticsSystem.Employee.Pages.HistoryPage" Title="Lịch sử" >
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
        <VerticalStackLayout Padding="24,32,24,24" Spacing="8" BackgroundColor="{StaticResource Canvas}">
            <Label Text="Lịch sử chấm công." Style="{StaticResource DisplayLg}" />
            <Label Text="Nhìn lại từng ngày làm việc của bạn." Style="{StaticResource Caption}" />
        </VerticalStackLayout>
        <Border Grid.Row="1" Margin="24,0" Padding="20" MaximumWidthRequest="760">
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Từ ngày" Style="{StaticResource Caption}" />
                        <DatePicker x:Name="FromPicker" Format="dd/MM/yyyy" SemanticProperties.Description="Ngày bắt đầu" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Đến ngày" Style="{StaticResource Caption}" />
                        <DatePicker x:Name="ToPicker" Format="dd/MM/yyyy" SemanticProperties.Description="Ngày kết thúc" />
                    </VerticalStackLayout>
                </Grid>
                <Button Text="Xem lịch sử" Clicked="OnLoadClicked" />
            </VerticalStackLayout>
        </Border>
        <Label Grid.Row="2" x:Name="StatusLabel" Style="{StaticResource Caption}" Margin="24,0" />
        <CollectionView Grid.Row="3" x:Name="RecordsView" Margin="24,0,24,16" MaximumWidthRequest="760">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,12" Padding="20">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding DateText}" Style="{StaticResource Tagline}" FontSize="17" />
                            <Label Text="{Binding StatusText}" Style="{StaticResource Caption}" />
                            <BoxView HeightRequest="1" />
                            <Label Text="{Binding TimesText}" />
                            <Label Text="{Binding NoteText}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
