<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="LogisticsSystem.Employee.Pages.AccountPage" Title="Tài khoản" >
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Border Style="{StaticResource DarkTile}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="HỒ SƠ CỦA BẠN" TextColor="{StaticResource BodyMutedOnDark}" FontSize="12" CharacterSpacing="1.5" />
                    <Label x:Name="NameLabel" Style="{StaticResource HeroDisplay}" />
                    <Label Text="Tài khoản công việc" Style="{StaticResource OnDarkBody}" />
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout Padding="24,32" Spacing="24" MaximumWidthRequest="760" HorizontalOptions="Center">
                <Label Text="Luôn kết nối." Style="{StaticResource Tagline}" />
                <Border>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Máy chủ kết nối" Style="{StaticResource Caption}" />
                        <Label x:Name="ServerLabel" LineBreakMode="CharacterWrap" />
                        <BoxView HeightRequest="1" />
                        <Label Text="Dữ liệu chấm công và yêu cầu điều chỉnh được đồng bộ với hệ thống của công ty." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="Đăng xuất" Style="{StaticResource SecondaryButton}" Clicked="OnLogoutClicked" />
                <Label Text="LOGISTICS / QR" Style="{StaticResource Caption}" CharacterSpacing="2" HorizontalTextAlignment="Center" Margin="0,16,0,0" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
